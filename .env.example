# Switchyard settings. Copy to .env (switchyard.sh / switchyard.bat do it for you). Docker Compose reads this file
# for the ${…} values in compose.switchyard.yml, and the CLI loads it too. A variable a service doesn't receive from
# compose.switchyard.yml has no effect on that service: each section says which service reads it.
# Leave the lines that `switchyard init` writes empty; it fills them in.

# Flagsmith API as seen from inside the compose network
FLAGSMITH_API_URL=http://flagsmith:8000/api/v1/

# Optional: another routing config, mounted into the proxy, console and CLI (default ./switchyard.config.yml).
# SWITCHYARD_CONFIG_FILE=./examples/landing/switchyard.config.yml

# Optional, bring your own Flagsmith: the existing project (name or id) and environment (name or key) that
# `switchyard init` reuses; it then creates no organisation, project or environment (same as --project/--environment).
# SWITCHYARD_PROJECT=
# SWITCHYARD_ENVIRONMENT=

# Server-side environment key (ser.…) of the environment Switchyard routes for.
# `switchyard init` writes it here on a fresh instance.
SWITCHYARD_SERVER_KEY=

# Organisation API key (admin on open-source Flagsmith). Only the localhost console
# and the init/ship/revert commands use it. `switchyard init` writes it on a fresh instance.
SWITCHYARD_ADMIN_KEY=

# Written by init on a fresh instance: the first Flagsmith admin's login. The console's judge tour shows the password
# only on this machine (loopback), never to other devices.
FLAGSMITH_ADMIN_EMAIL=
FLAGSMITH_ADMIN_PASSWORD=

# Optional: write experiment results into GitHub Releases (console and CLI)
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# Written by init: the experiment the CLI and console default to (<environment key>/<id>)
SWITCHYARD_EXPERIMENT=

# Written by init: opens the preview stage (/__switchyard/preview?token=…) and the proxy's debug headers.
# Rotate it to revoke every preview browser.
SWITCHYARD_PREVIEW_TOKEN=

# ---- Judge mode and other devices ------------------------------------------------------------------------------
# Judge mode: http://127.0.0.1:8090/judge runs the whole story with buttons (simulated visitors, results, Ship/Revert,
# swing-back, preview, release, reset). Written by init: opens judge mode on other devices via
# <console>/judge?key=<token>, which leaves a cookie for a day. Rotate it to revoke every judge browser.
SWITCHYARD_JUDGE_TOKEN=
# Hostnames or IPs other devices use to reach the console (comma list, e.g. 192.168.1.20). Each needs the judge link,
# which init prints for the first one (port 8091, the console's port for other devices). The shops also let the
# console on these hosts (port 8091) show them in a frame.
# The console refuses to start if this is set without SWITCHYARD_JUDGE_TOKEN.
SWITCHYARD_CONSOLE_HOSTS=
# Where Compose publishes the proxy (:8080) and the console's port for other devices (:8091, judge link only).
# 127.0.0.1 = this machine only; 0.0.0.0 lets phones on your network reach both (requires SWITCHYARD_JUDGE_TOKEN and
# SWITCHYARD_CONSOLE_HOSTS). Flagsmith (:8000) and this machine's console (:8090) always stay on 127.0.0.1.
SWITCHYARD_PUBLISH_HOST=127.0.0.1
# The shop URL a judge's browser opens (and the base of the preview link). For other devices, e.g.
# http://192.168.1.20:8080, and open judge mode with the same hostname (the judge link) on every device: the Shop tab
# needs the console and the shop on the same hostname, or the browser drops the shop's cookies in the frame.
# 127.0.0.1 rather than localhost: Compose publishes on 127.0.0.1 only, and on Windows a client that tries
# localhost's IPv6 address (::1) first waits for that attempt to be refused before it falls back.
SWITCHYARD_PUBLIC_SHOP_URL=http://127.0.0.1:8080
# Flagsmith's dashboard, for links from judge mode and init
FLAGSMITH_DASHBOARD_URL=http://127.0.0.1:8000
# True order rate per release for judge mode's simulated visitors (inputs, not evidence)
SWITCHYARD_DEMO_RATES=shop:1.4=0.10,shop:1.5=0.135,shop:1.6=0.17
# Optional: the shops' whole CSP frame-ancestors list (space-separated sources, e.g. 'self' https://console.example),
# in place of the console on this machine plus SWITCHYARD_CONSOLE_HOSTS. A value with ";" or "," is ignored.
#SHOP_FRAME_ANCESTORS=

# ---- Console: Flagsmith Feature Health and the guard ------------------------------------------------------------
# Written by init: the URL of Flagsmith's Feature Health "Webhook" provider (its path is a secret). The console
# reports the release flag's health there, so a losing guardrail tags the flag "Unhealthy" in Flagsmith's dashboard.
SWITCHYARD_HEALTH_WEBHOOK=

# The guard (off by default): "revert" makes the console refresh Flagsmith's results every 5 minutes and revert the
# running experiment on its own when a guardrail's chance to win is at or under the threshold. It never ships.
# Judge mode can also switch it on and off at runtime.
SWITCHYARD_GUARD=off
SWITCHYARD_GUARD_THRESHOLD=0.01

# ---- Proxy ------------------------------------------------------------------------------------------------------
# "1" marks the proxy's cookies Secure. Set it when the shop is served over HTTPS (a TLS proxy in front of :8080).
#SWITCHYARD_SECURE_COOKIES=1
# "0" turns off the proxy's access log lines (one per request, on stdout).
#SWITCHYARD_ACCESS_LOG=0

# ---- Linux: the user the console and the CLI run as -------------------------------------------------------------
# They write .switchyard/ (snapshots, the release ledger) and .env through bind mounts, so they run as the user that
# owns this folder. The default, 1000:1000, is the image's `node` user. switchyard.sh sets both to `id -u` / `id -g`
# on Linux; set them here when you run `docker compose` yourself as another user. Not needed on macOS or Windows.
#SWITCHYARD_UID=1000
#SWITCHYARD_GID=1000

# ---- CLI only ---------------------------------------------------------------------------------------------------
# `switchyard code-refs`: the Flagsmith project to submit Code References to (default: SWITCHYARD_EXPERIMENT's).
#SWITCHYARD_PROJECT_ID=
# Code References (init, code-refs): the repository and commit Flagsmith's links point at, when this checkout has no
# https GitHub "origin" remote. In GitHub Actions, GITHUB_SERVER_URL, GITHUB_REPOSITORY and GITHUB_SHA are used.
#SWITCHYARD_REPOSITORY_URL=https://github.com/<owner>/<repo>
#SWITCHYARD_REVISION=main
# `switchyard doctor`: where the console answers (default http://console:8090 in Compose, http://127.0.0.1:8090
# with --api-url on 127.0.0.1 or localhost).
#SWITCHYARD_CONSOLE_URL=

# ---- Set by Compose, or only for running outside Docker -----------------------------------------------------------
# Compose sets these for each service (compose.switchyard.yml); a value here doesn't change them in the containers.
# Running `node src/cli.ts …` directly, these are the defaults:
#   SWITCHYARD_PROXY_URL=http://switchyard:8080      where `demo`, `doctor` and judge mode send visitors
#   SWITCHYARD_FEED_URL=http://switchyard:8081       the proxy's traffic feed, read by the console
#   FLAGSMITH_METRICS_URL=                           Flagsmith's Prometheus endpoint (Compose: http://flagsmith:9100/metrics)
#   PORT=8080  FEED_PORT=8081                        the proxy's ports
#   CONSOLE_PORT=8090  CONSOLE_HOST=127.0.0.1        the console's port and listen address (Compose: 0.0.0.0)
#   CONSOLE_DEVICE_PORT=                             a second console port for other devices (Compose: 8091)
#   SWITCHYARD_CONFIG=switchyard.config.yml          the routing config
#   SWITCHYARD_STATE_DIR=.switchyard                 snapshots, the ledger, the last known live release
#   SWITCHYARD_ENV_FILE=.env                         the settings file the CLI loads (and init writes)
# The demo shop (demo/shop/server.ts): SHOP_VERSION (1.4, 1.5, 1.6), PORT, SEEDED_DELAY_MS and SEEDED_ERROR_RATE
# (labelled, seeded faults), SHOP_FRAME_HOSTS (Compose passes SWITCHYARD_CONSOLE_HOSTS) and SHOP_FRAME_ANCESTORS.
# The landing example (demo/landing/server.ts): LANDING_VERSION (1 or 2, set by its Dockerfile) and PORT.
