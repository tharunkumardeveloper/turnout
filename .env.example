# Turnout settings. Copy to .env (turnout.sh / turnout.bat do it for you). Docker Compose reads this file
# for the ${…} values in compose.turnout.yml, and the CLI loads it too. A variable a service doesn't receive from
# compose.turnout.yml has no effect on that service: each section says which service reads it.
# Leave the lines that `turnout init` writes empty; it fills them in.

# Flagsmith API as seen from inside the compose network
FLAGSMITH_API_URL=http://flagsmith:8000/api/v1/

# Optional: another routing config, mounted into the proxy, console and CLI (default ./turnout.config.yml).
# TURNOUT_CONFIG_FILE=./examples/landing/turnout.config.yml

# Optional, bring your own Flagsmith: the existing project (name or id) and environment (name or key) that
# `turnout init` reuses; it then creates no organisation, project or environment (same as --project/--environment).
# TURNOUT_PROJECT=
# TURNOUT_ENVIRONMENT=

# Server-side environment key (ser.…) of the environment Turnout routes for.
# `turnout init` writes it here on a fresh instance.
TURNOUT_SERVER_KEY=

# Organisation API key (admin on open-source Flagsmith). Only the localhost console
# and the init/ship/revert commands use it. `turnout init` writes it on a fresh instance.
TURNOUT_ADMIN_KEY=

# Written by init on a fresh instance: the first Flagsmith admin's login. The console's judge tour shows the password
# only on this machine (loopback), never to other devices.
FLAGSMITH_ADMIN_EMAIL=
FLAGSMITH_ADMIN_PASSWORD=

# Optional: write experiment results into GitHub Releases (console and CLI)
GITHUB_TOKEN=
GITHUB_REPOSITORY=

# Written by init: the experiment the CLI and console default to (<environment key>/<id>)
TURNOUT_EXPERIMENT=

# Written by init: opens the preview stage (/__turnout/preview?token=…) and the proxy's debug headers.
# Rotate it to revoke every preview browser.
TURNOUT_PREVIEW_TOKEN=

# ---- Judge mode and other devices ------------------------------------------------------------------------------
# Judge mode: http://127.0.0.1:8090/judge runs the whole story with buttons (simulated visitors, results, Ship/Revert,
# swing-back, preview, release, reset). Written by init: opens judge mode on other devices via
# <console>/judge?key=<token>, which leaves a cookie for a day. Rotate it to revoke every judge browser.
TURNOUT_JUDGE_TOKEN=
# Hostnames or IPs other devices use to reach the console (comma list, e.g. 192.168.1.20). Each needs the judge link,
# which init prints for the first one (port 8091, the console's port for other devices). The shops also let the
# console on these hosts (port 8091) show them in a frame.
# The console refuses to start if this is set without TURNOUT_JUDGE_TOKEN.
TURNOUT_CONSOLE_HOSTS=
# Where Compose publishes the proxy (:8080) and the console's port for other devices (:8091, judge link only).
# 127.0.0.1 = this machine only; 0.0.0.0 lets phones on your network reach both (requires TURNOUT_JUDGE_TOKEN and
# TURNOUT_CONSOLE_HOSTS). Flagsmith (:8000) and this machine's console (:8090) always stay on 127.0.0.1.
TURNOUT_PUBLISH_HOST=127.0.0.1
# The shop URL a judge's browser opens (and the base of the preview link). For other devices, e.g.
# http://192.168.1.20:8080, and open judge mode with the same hostname (the judge link) on every device: the Shop tab
# needs the console and the shop on the same hostname, or the browser drops the shop's cookies in the frame.
# 127.0.0.1 rather than localhost: Compose publishes on 127.0.0.1 only, and on Windows a client that tries
# localhost's IPv6 address (::1) first waits for that attempt to be refused before it falls back.
TURNOUT_PUBLIC_SHOP_URL=http://127.0.0.1:8080
# Flagsmith's dashboard, for links from judge mode and init
FLAGSMITH_DASHBOARD_URL=http://127.0.0.1:8000
# Judge mode (/judge): the demo shop's guided test with simulated shoppers. turnout compare sets it off for your own
# app, so simulated shoppers can never reach your real experiment (turnout simulate keeps them in their own environment).
#TURNOUT_JUDGE=on
# Try it with your app (local mode): the console's Try it box relays to the tryit service, which builds and runs your
# versions over the Docker socket. Compose sets these; server mode sets TURNOUT_TRYIT_URL empty (no Try it on a server).
#TURNOUT_TRYIT_URL=http://tryit:8097
#TURNOUT_TRYIT_SHOP_URL=http://127.0.0.1:8085
#TRYIT_PORT=8097
#TRYIT_PROXY_PORT=8085
#TRYIT_CONSOLE_PORT=8099
# Each version on its own address (A, B, C) for previews, never counted; published on 127.0.0.1 only.
#TRYIT_PREVIEW_PORTS=8086,8087,8088
# Flagsmith's dashboard with Turnout's tour on top (local): a pass-through that adds one script. Empty: off.
#FLAGSMITH_TOUR_PORT=8001
#FLAGSMITH_TOUR_UPSTREAM=http://flagsmith:8000
# Where a browser reaches it (default http://127.0.0.1:<port>); the console's Flagsmith links open it.
#FLAGSMITH_TOUR_URL=http://127.0.0.1:8001
# Your app's console (the console shows it at /app); default: the Try it host on port 8099; empty: none.
#TURNOUT_TRYIT_CONSOLE_URL=http://tryit:8099
# True order rate per release for judge mode's simulated visitors (inputs, not evidence)
TURNOUT_DEMO_RATES=shop:1.4=0.10,shop:1.5=0.20,shop:1.6=0.22
# Simulated visitors in flight at once (judge mode). Default 20.
#TURNOUT_DEMO_CONCURRENCY=20
# How long one read of judge mode's state is shared by every viewer, in ms (default 1500; server mode 3000)
#TURNOUT_STATE_CACHE_MS=1500
# Blind rounds in judge mode: random hidden true rates per A/B round, revealed after the decision with a scoreboard
# (server mode: on; locally off, so the demo tells the same story every time)
#TURNOUT_BLIND=on
# The demo release with the deliberate slowness, whose speed guardrail must stop it in a blind round
#TURNOUT_DEMO_SLOW_RELEASE=shop:1.6
# Server mode: the flag of the live experiment for real visitors (turnout.live.yml), shown on the public judge page
#TURNOUT_LIVE_FLAG=shop_release_live
# turnout simulate (set by the wrapper): the real environment, whose project gets the Demo one; where pretend visitors go;
# and the simulation console's label
#TURNOUT_REAL_ENV_KEY=
#TURNOUT_SIM_TARGET=http://turnout-sim:8080
#TURNOUT_SIMULATED=1
# Server mode's live proxy: let a browser look at one chosen release, never counted (/__turnout/view?release=…)
#TURNOUT_VIEW_SWITCH=1
# Optional: the shops' whole CSP frame-ancestors list (space-separated sources, e.g. 'self' https://console.example),
# in place of the console on this machine plus TURNOUT_CONSOLE_HOSTS. A value with ";" or "," is ignored.
#SHOP_FRAME_ANCESTORS=

# ---- Console: Flagsmith Feature Health and the guard ------------------------------------------------------------
# Written by init: the URL of Flagsmith's Feature Health "Webhook" provider (its path is a secret). The console
# reports the release flag's health there, so a losing guardrail tags the flag "Unhealthy" in Flagsmith's dashboard.
TURNOUT_HEALTH_WEBHOOK=

# The guard (off by default): "revert" makes the console refresh Flagsmith's results every 5 minutes and revert the
# running experiment on its own when a guardrail's chance to win is at or under the threshold. It never ships.
# Judge mode can also switch it on and off at runtime.
TURNOUT_GUARD=off
TURNOUT_GUARD_THRESHOLD=0.01

# ---- Proxy ------------------------------------------------------------------------------------------------------
# "1" marks the proxy's cookies Secure. Set it when the shop is served over HTTPS (a TLS proxy in front of :8080).
#TURNOUT_SECURE_COOKIES=1
# A parent domain for the visitor cookie, so a console on that domain can read where a visitor landed (server mode:
# the shop on shop.<host>, the console on <host>; compose.server.yml sets it).
#TURNOUT_COOKIE_DOMAIN=example.com
# "1" lets the public page run the guided demo's own steps (simulated shoppers only, rate-limited; compose.server.yml sets it).
#TURNOUT_PUBLIC_PLAY=1
# "0" turns off the proxy's access log lines (one per request, on stdout).
#TURNOUT_ACCESS_LOG=0

# ---- Server mode (docs/SETUP.md, "Running on a server") ---------------------------------------------------------
# `sh turnout.sh server <hostname>` (or turnout.bat server <hostname>) writes these lines; after that every
# compose command also uses compose.server.yml: Caddy with HTTPS on the hostname, a read-only judge view at
# https://<hostname>/judge, restart: unless-stopped, Flagsmith and the console on 127.0.0.1 only (SSH tunnel).
# "local" (or unset) is the stack as above. Server mode refuses to start while a secret or token below is a placeholder.
#TURNOUT_MODE=local
#TURNOUT_HOSTNAME=turnout.example.com
# Empty: a public certificate (Let's Encrypt). "tls internal": Caddy's own CA (CI, or a trial on hostname localhost).
#TURNOUT_CADDY_TLS=
# Flagsmith's and Postgres' secrets in server mode, in place of the official file's placeholders. The server command
# writes random ones where these are empty, and never replaces one (Postgres keeps the password it was created with).
#FLAGSMITH_DJANGO_SECRET_KEY=
#FLAGSMITH_WAREHOUSE_SECRET=
#POSTGRES_PASSWORD=
# The autopilot: the public /judge view is read-only, so the console runs the story by itself (visitors, Flagsmith's
# results, Turnout's recommendation, verify, preview, release, reset, again). On by default in server mode; off: off.
# Visitors per step (50-3000, default 600) and the pause between steps in seconds (default 25).
#TURNOUT_AUTOPILOT=on
#TURNOUT_AUTOPILOT_VISITORS=2000
#TURNOUT_AUTOPILOT_PAUSE=4
#TURNOUT_AUTOPILOT_END_PAUSE=15
# Set by compose.server.yml or the scripts, not here: CONSOLE_PUBLIC_PORT (the console's read-only port for Caddy,
# 8092, never published), TURNOUT_EDGE_ADDRESS (where doctor reaches Caddy: caddy) and TURNOUT_RESTART_POLICIES
# (read from Docker by turnout.sh / turnout.bat for doctor).

# ---- Linux: the user the console and the CLI run as -------------------------------------------------------------
# They write .turnout/ (snapshots, the release ledger) and .env through bind mounts, so they run as the user that
# owns this folder. The default, 1000:1000, is the image's `node` user. turnout.sh sets both to `id -u` / `id -g`
# on Linux; set them here when you run `docker compose` yourself as another user. Not needed on macOS or Windows.
#TURNOUT_UID=1000
#TURNOUT_GID=1000

# ---- CLI only ---------------------------------------------------------------------------------------------------
# `turnout code-refs`: the Flagsmith project to submit Code References to (default: TURNOUT_EXPERIMENT's).
#TURNOUT_PROJECT_ID=
# Code References (init, code-refs): the repository and commit Flagsmith's links point at, when this checkout has no
# https GitHub "origin" remote. In GitHub Actions, GITHUB_SERVER_URL, GITHUB_REPOSITORY and GITHUB_SHA are used.
#TURNOUT_REPOSITORY_URL=https://github.com/<owner>/<repo>
#TURNOUT_REVISION=main
# `turnout check` in CI: also write its result as Markdown to this file (the Action sets it, and `turnout pr-comment`
# posts it on the pull request). GitHub Actions sets GITHUB_STEP_SUMMARY (the job summary, also written), GITHUB_RUN_ID
# (the run's link), GITHUB_EVENT_PATH (which pull request), GITHUB_API_URL and GITHUB_TOKEN (the comment).
#TURNOUT_REPORT_FILE=
# `turnout doctor`: where the console answers (default http://console:8090 in Compose, http://127.0.0.1:8090
# with --api-url on 127.0.0.1 or localhost).
#TURNOUT_CONSOLE_URL=

# ---- Set by Compose, or only for running outside Docker -----------------------------------------------------------
# Compose sets these for each service (compose.turnout.yml); a value here doesn't change them in the containers.
# Running `node src/cli.ts …` directly, these are the defaults:
#   TURNOUT_PROXY_URL=http://turnout:8080      where `demo`, `doctor` and judge mode send visitors
#   TURNOUT_FEED_URL=http://turnout:8081       the proxy's traffic feed, read by the console
#   FLAGSMITH_METRICS_URL=                           Flagsmith's Prometheus endpoint (Compose: http://flagsmith:9100/metrics)
#   PORT=8080  FEED_PORT=8081                        the proxy's ports
#   CONSOLE_PORT=8090  CONSOLE_HOST=127.0.0.1        the console's port and listen address (Compose: 0.0.0.0)
#   CONSOLE_DEVICE_PORT=                             a second console port for other devices (Compose: 8091)
#   TURNOUT_PUBLIC_CONSOLE_PORT=8090              the console port on this machine, for the judge link init prints
#   TURNOUT_CONFIG=turnout.config.yml          the routing config
#   TURNOUT_STATE_DIR=.turnout                 snapshots, the ledger, the last known live release
#   TURNOUT_ENV_FILE=.env                         the settings file the CLI loads (and init writes)
# The demo shop (demo/shop/server.ts): SHOP_VERSION (1.4, 1.5, 1.6), PORT, SEEDED_DELAY_MS and SEEDED_ERROR_RATE
# (labelled, seeded faults), SHOP_RIBBON (1 shows the demo-only release ribbon; compose.demo.yml defaults it on),
# SHOP_FRAME_HOSTS (Compose passes TURNOUT_CONSOLE_HOSTS) and SHOP_FRAME_ANCESTORS.
# The landing example (demo/landing/server.ts): LANDING_VERSION (1 or 2, set by its Dockerfile) and PORT.

# turnout try / goals / results (local, Try it): where the console is. Default http://127.0.0.1:8090
# TURNOUT_CONSOLE=http://127.0.0.1:8090
#   TURNOUT_TRYIT_SHARED_ENV=1                    Try it uses the main Flagsmith environment instead of its own
#                                                 "Try it (simulated visitors)"
