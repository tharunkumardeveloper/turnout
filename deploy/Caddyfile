# Server mode's front door (compose.server.yml mounts it). Caddy fills {$…} from the environment Compose gives it, so
# the site below is built from TURNOUT_HOSTNAME: turnout.sh server <hostname> writes it into .env.
#
#   https://<hostname>/judge, /judge/*   GET and HEAD only, to the console's read-only port (8092, never published)
#   anything else on the hostname        to the Turnout proxy, which routes it to a release
# Flagsmith and the console's own ports are not here at all: they stay on 127.0.0.1 (SSH tunnel).
{
	admin off
}

{$TURNOUT_HOSTNAME} {
	# Empty for a public certificate; "tls internal" (TURNOUT_CADDY_TLS) for Caddy's own CA in CI or a trial.
	{$TURNOUT_CADDY_TLS}

	@judge path /judge /judge/*
	handle @judge {
		@read method GET HEAD
		handle @read {
			reverse_proxy console:8092
		}
		header Allow "GET, HEAD"
		respond "Read-only view: actions run only from the console on the server." 405
	}

	handle {
		reverse_proxy turnout:8080
	}
}
